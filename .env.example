# EDDN Validator settings. Copy to .env and fill in; .env is git-ignored and
# kept out of the Docker build context. docker compose reads it on the machine
# you deploy from.

# --- PostgreSQL server -------------------------------------------------------
# Address of the Postgres server as seen from inside the containers.
PGHOST=your-postgres-host
PGPORT=5432
# Database the validator uses. `bootstrap` creates it.
PGDATABASE=eddn_validator

# --- Role passwords ------------------------------------------------------------
# `bootstrap` creates these two roles with these passwords (or resets the
# passwords if the roles already exist).
#   eddn_app : owns the database; used by migrate, listener and worker
#   eddn_ro  : SELECT-only; used by the web front end
EDDN_APP_PASSWORD=
EDDN_RO_PASSWORD=

# --- One-time admin login --------------------------------------------------------
# Only needed for `bootstrap` (creating the roles and database). Must be able
# to CREATE ROLE and CREATE DATABASE. Only the migrate container receives it.
# Can be blanked out again after bootstrap has run.
PG_ADMIN_USER=
PG_ADMIN_PASSWORD=
PG_ADMIN_DATABASE=postgres

# --- Optional ---------------------------------------------------------------------
# EDDN relay to subscribe to.
EDDN_RELAY=tcp://eddn.edcd.io:9500
# GitHub token for the release poll. Optional: unauthenticated requests are
# enough at one poll every 6 hours.
GITHUB_TOKEN=
# DEBUG, INFO, WARNING
LOG_LEVEL=INFO

# --- Private ED Outrider page --------------------------------------------------
# Host port for the private Outrider usage page (LAN only).
OUTRIDER_PORT=8026

# --- Public scorecard site ------------------------------------------------------
# Host port for the scorecard site (put a reverse proxy in front for the internet).
WEB_PORT=8027
# Outrider's database on the PC that sends to EDDN, read by `mark-mine`
# (run on that PC, not in Docker).
OUTRIDER_OUTBOX=

# --- Size guard -------------------------------------------------------------------
# An empty directory on the drive that holds the Postgres data, mounted read-only into
# the worker so the size guard can see that drive's free space (config/retention.yaml).
DISK_PROBE_DIR=/srv/eddn-validator/disk-probe
